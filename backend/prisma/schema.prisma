// CV Optimizer - Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  applied
  hr_interview
  user_interview
  technical_test
  offer
  rejected
  ghosted
  withdrawn
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  picture   String?  // Google profile photo URL
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cvVersions   CvVersion[]
  applications Application[]
  experienceVault ExperienceVaultItem[]
  usageCredit  UsageCredit?
  aiJobReservations AiJobReservation[]
  creditLedger CreditLedgerEntry[]
  paymentTransactions PaymentTransaction[]
  aiCostLogs AiCostLog[]
  funnelEvents FunnelEvent[]
}

model ExperienceVaultItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  company        String
  role           String
  periodStart    String?
  periodEnd      String?
  category       String   @default("technical")
  skillsUsed     String[]

  situation      String   @db.Text
  task           String   @db.Text
  action         String   @db.Text
  result         String   @db.Text

  polishedBullet String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
}

model CvVersion {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  label       String?
  structured  Json // structured CV JSON (personalInfo, summary, skills, experience...)
  createdAt   DateTime @default(now())

  applications Application[]
}

model Application {
  id             String            @id @default(cuid())
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  cvVersionId    String?
  cvVersion      CvVersion?        @relation(fields: [cvVersionId], references: [id])

  // Job info
  company        String?
  position       String?
  jobDescription String
  jobUrl         String?           // link to job posting

  // Analysis
  matchScore     Int?
  hireProb       Int?              // hire probability 0-100
  analysis       Json?

  // Tracking
  status         ApplicationStatus @default(applied)
  appliedAt      DateTime          @default(now())
  notes          String?

  // Timestamps
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model UsageCredit {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  used        Int      @default(0)
  limit       Int      @default(10)
  periodStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiJobReservation {
  id          String   @id @default(cuid())
  jobId       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  status      String   @default("reserved")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, periodStart])
}

enum LedgerEntryType {
  GRANT
  USAGE
  REFUND
  PURCHASE
  EXPIRY
}

model CreditLedgerEntry {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int             // positive for additions, negative for deductions
  balanceAfter Int
  type         LedgerEntryType
  reason       String
  jobId        String?
  referenceId  String?         // paymentTransactionId, promoId, etc.
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey  String        @unique
  orderId         String        @unique
  gateway         String        @default("midtrans") // midtrans, stripe, xendit
  amount          Int           // e.g. 9900 IDR, 39000 IDR
  currency        String        @default("IDR")
  creditsGranted  Int
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  rawPayload      Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model AiCostLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId            String?
  taskType         String   // analyze, tailor, cover_letter, interview
  model            String   @default("gemini-3.5-flash-lite")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  latencyMs        Int      @default(0)
  retryCount       Int      @default(0)
  status           String   @default("success") // success, failed
  error            String?
  createdAt        DateTime @default(now())

  @@index([taskType])
  @@index([createdAt])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  eventName String   // landing_viewed, upload_started, analysis_completed, export_completed, checkout_started, payment_success, repeat_optimization
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
}

