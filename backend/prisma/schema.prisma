// CV Optimizer - Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  applied
  hr_interview
  user_interview
  technical_test
  offer
  rejected
  ghosted
  withdrawn
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  picture   String?  // Google profile photo URL
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cvVersions   CvVersion[]
  applications Application[]
  usageCredit  UsageCredit?
}

model CvVersion {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  label       String?
  structured  Json // structured CV JSON (personalInfo, summary, skills, experience...)
  createdAt   DateTime @default(now())

  applications Application[]
}

model Application {
  id             String            @id @default(cuid())
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  cvVersionId    String?
  cvVersion      CvVersion?        @relation(fields: [cvVersionId], references: [id])

  // Job info
  company        String?
  position       String?
  jobDescription String
  jobUrl         String?           // link to job posting

  // Analysis
  matchScore     Int?
  hireProb       Int?              // hire probability 0-100
  analysis       Json?

  // Tracking
  status         ApplicationStatus @default(applied)
  appliedAt      DateTime          @default(now())
  notes          String?

  // Timestamps
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model UsageCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  used      Int      @default(0)
  limit     Int      @default(10)  // increased from 2 for logged-in users
  updatedAt DateTime @updatedAt
}
